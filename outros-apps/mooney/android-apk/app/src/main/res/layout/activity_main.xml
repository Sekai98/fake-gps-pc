<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0f1419"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Step Tracker"
            android:textColor="#4caf50"
            android:textSize="32sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="v0.3.0 — Mock GPS + Autopilot + Health Connect"
            android:textColor="#9aa0a6"
            android:textSize="13sp"
            android:gravity="center"
            android:paddingBottom="24dp"/>

        <TextView
            android:id="@+id/today_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hoje: carregando..."
            android:textColor="#4caf50"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="#1a2029"
            android:padding="16dp"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PERMISSÕES"
            android:textColor="#9aa0a6"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingBottom="8dp"/>

        <TextView
            android:id="@+id/status_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="○ Localização"
            android:textColor="#e8eaed"
            android:textSize="14sp"
            android:paddingTop="4dp"/>
        <Button
            android:id="@+id/btn_perm_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Autorizar localização"
            android:textAllCaps="false"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/status_health"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="○ Health Connect"
            android:textColor="#e8eaed"
            android:textSize="14sp"
            android:paddingTop="12dp"/>
        <Button
            android:id="@+id/btn_perm_health"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Autorizar Health Connect"
            android:textAllCaps="false"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/status_notif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="○ Notificações"
            android:textColor="#e8eaed"
            android:textSize="14sp"
            android:paddingTop="12dp"/>
        <Button
            android:id="@+id/btn_perm_notif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Autorizar notificações"
            android:textAllCaps="false"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/status_mock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="○ Mock GPS"
            android:textColor="#e8eaed"
            android:textSize="14sp"
            android:paddingTop="12dp"/>
        <Button
            android:id="@+id/btn_open_dev"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Abrir Opções de Desenvolvedor"
            android:textAllCaps="false"
            android:layout_marginTop="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AÇÃO"
            android:textColor="#9aa0a6"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingTop="24dp"
            android:paddingBottom="8dp"/>

        <Button
            android:id="@+id/btn_open_map"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="▶  Abrir mapa pra andar"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:backgroundTint="#4caf50"
            android:enabled="false"/>

        <Button
            android:id="@+id/btn_stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⏹  Parar service"
            android:textAllCaps="false"
            android:layout_marginTop="12dp"
            android:backgroundTint="#e53935"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Como usar:\n\n1. Ative Opções de Desenvolvedor (Settings → Sobre → toque 7x em Número da versão)\n2. Em Opções de Dev → App de localização simulada → selecione Step Tracker\n3. Autoriza as permissões acima\n4. Abre Mooney e conecta Health Connect\n5. Volta aqui → Abrir mapa → escolhe velocidade e destino → Andar\n\nResultado: Android reporta localização falsa pros outros apps + injeta passos no Health Connect.\n\n⚠ Use conta scout/queimável. Mooney/Weward podem detectar e banir."
            android:textColor="#9aa0a6"
            android:textSize="12sp"
            android:paddingTop="30dp"
            android:lineSpacingExtra="4dp"/>

    </LinearLayout>
</ScrollView>
