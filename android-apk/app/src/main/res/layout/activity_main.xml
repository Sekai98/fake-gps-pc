<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0f1419"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FakeGPS"
            android:textColor="#4285f4"
            android:textSize="36sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="30dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Joystick flutuante + mock location"
            android:textColor="#9aa0a6"
            android:textSize="14sp"
            android:gravity="center"
            android:paddingBottom="30dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PERMISSOES"
            android:textColor="#9aa0a6"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"/>

        <TextView
            android:id="@+id/status_overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✗ Falta: desenhar sobre outros apps"
            android:textColor="#e8eaed"
            android:textSize="14sp"
            android:paddingBottom="6dp"/>
        <Button
            android:id="@+id/btn_overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Autorizar desenhar sobre apps"
            android:textAllCaps="false"/>

        <TextView
            android:id="@+id/status_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✗ Falta: autorizar localizacao"
            android:textColor="#e8eaed"
            android:textSize="14sp"
            android:paddingTop="12dp"
            android:paddingBottom="6dp"/>
        <Button
            android:id="@+id/btn_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Autorizar localizacao"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/btn_notif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Autorizar notificacoes"
            android:textAllCaps="false"
            android:layout_marginTop="12dp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/status_mock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ℹ Ative este app como App de localizacao simulada nas Opcoes do Desenvolvedor"
            android:textColor="#f9ab00"
            android:textSize="13sp"
            android:paddingTop="18dp"
            android:paddingBottom="6dp"/>
        <Button
            android:id="@+id/btn_dev_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Abrir Opcoes do Desenvolvedor"
            android:textAllCaps="false"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ACAO"
            android:textColor="#9aa0a6"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingTop="30dp"
            android:paddingBottom="8dp"/>

        <Button
            android:id="@+id/btn_start"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="▶  Iniciar Fake GPS"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:backgroundTint="#0f9d58"
            android:enabled="false"/>

        <Button
            android:id="@+id/btn_stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⏹  Parar"
            android:textAllCaps="false"
            android:layout_marginTop="12dp"
            android:backgroundTint="#e53935"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Apos iniciar: minimize este app, abra o Chrome e vá em gocollect.fun. O joystick flutuante ficara sobre qualquer app."
            android:textColor="#9aa0a6"
            android:textSize="12sp"
            android:paddingTop="20dp"
            android:lineSpacingExtra="4dp"/>

    </LinearLayout>
</ScrollView>
