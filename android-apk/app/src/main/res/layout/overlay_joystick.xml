<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="end">

    <!-- Barra de presets de velocidade -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#CC1a2029"
        android:padding="4dp"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/drag_handle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⋮⋮"
            android:textColor="#9aa0a6"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="6dp"
            android:layout_marginEnd="3dp"
            android:background="#333a44"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/preset_walk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚶 5"
            android:textColor="#ffffff"
            android:textSize="12sp"
            android:padding="6dp"
            android:background="#4285f4"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="3dp"/>

        <TextView
            android:id="@+id/preset_run"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏃 12"
            android:textColor="#ffffff"
            android:textSize="12sp"
            android:padding="6dp"
            android:background="#333a44"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="3dp"/>

        <TextView
            android:id="@+id/preset_car"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚗 50"
            android:textColor="#ffffff"
            android:textSize="12sp"
            android:padding="6dp"
            android:background="#333a44"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- Joystick + botao fechar -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <com.fakegps.JoystickOverlayView
            android:id="@+id/joystick"
            android:layout_width="180dp"
            android:layout_height="180dp"/>

        <TextView
            android:id="@+id/btn_close"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="top|end"
            android:text="✕"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="#e53935"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"/>
    </FrameLayout>

    <!-- Label de velocidade atual -->
    <TextView
        android:id="@+id/speed_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0.0 km/h"
        android:textColor="#4caf50"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="#CC1a2029"
        android:padding="6dp"
        android:layout_marginTop="4dp"
        android:layout_gravity="end"
        android:fontFamily="monospace"/>

</LinearLayout>
